# Node / Vite プロジェクト向け .gitignore

# 依存パッケージ
node_modules/

# ビルド成果物
dist/
dist-ssr/

# ログ
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# テスト・カバレッジ
coverage/

# 環境変数
.env
.env.local
.env.*.local

# エディタ・OS固有ファイル
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Viteキャッシュ
.vite/
